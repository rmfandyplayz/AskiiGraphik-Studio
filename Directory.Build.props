<!-- Written with Claude Code (Anthropic). -->
<!-- Settings shared by every project in the repo. -->
<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>AskiiArt</Product>
  </PropertyGroup>

  <PropertyGroup Label="Analyzers">
    <!-- The SDK's built-in .NET analyzers; individual rules are tuned in .editorconfig. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unnecessary usings) to run during build. Missing-doc warnings
         (CS1591) are enabled for Core only, in .editorconfig. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
