<!-- Written with Claude Code (Anthropic). -->
<!-- Avalonia.Headless interaction tests. Few and focused; no pixel or layout assertions about
     placeholder UI (ARCHITECTURE §19). -->
<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\src\AskiiArt.App\AskiiArt.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- Referenced directly so the build fails with NU1605 (package downgrade) if Avalonia ever
         needs a newer SkiaSharp than the one pinned in Directory.Packages.props. -->
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- A real font file for the Load from File tests. -->
    <None Include="..\..\src\AskiiArt.Imaging\Fonts\Bundled\FiraCode\FiraCode-Regular.ttf"
          Link="TestFonts\FiraCode-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
