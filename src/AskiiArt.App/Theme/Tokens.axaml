<!-- Written with Claude Code (Anthropic). -->
<!-- Design tokens (ARCHITECTURE §14.5). Placeholder UI uses only these, never literal colors or
     sizes, so the owner's design system can replace them in one place. Colors have a light and a
     dark value; everything else is shared. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FF5F5F5F" />
      <SolidColorBrush x:Key="AppCanvasPasteboardBrush" Color="#FFC8C8C8" />
      <SolidColorBrush x:Key="AppCanvasPaperBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AppCanvasInkBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="AppCanvasGridLineBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="AppCanvasHoverBrush" Color="#400078D7" />
      <SolidColorBrush x:Key="AppCanvasFallbackGlyphBrush" Color="#FFFFD699" />
      <SolidColorBrush x:Key="AppCanvasPlaceholderGlyphBrush" Color="#FFFF9E9E" />
      <SolidColorBrush x:Key="AppCanvasCaretBrush" Color="#FF0078D7" />
      <SolidColorBrush x:Key="AppWarningTextBrush" Color="#FF9A5B00" />
      <SolidColorBrush x:Key="AppWidgetBrush" Color="#D9F3F3F3" />
      <SolidColorBrush x:Key="AppDropZoneBrush" Color="#400078D7" />
      <SolidColorBrush x:Key="AppLandingOutlineBrush" Color="#FF0078D7" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FFB4B4B4" />
      <SolidColorBrush x:Key="AppCanvasPasteboardBrush" Color="#FF141414" />
      <SolidColorBrush x:Key="AppCanvasPaperBrush" Color="#FF262626" />
      <SolidColorBrush x:Key="AppCanvasInkBrush" Color="#FFE8E8E8" />
      <SolidColorBrush x:Key="AppCanvasGridLineBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="AppCanvasHoverBrush" Color="#504C9EEB" />
      <SolidColorBrush x:Key="AppCanvasFallbackGlyphBrush" Color="#FF6B5420" />
      <SolidColorBrush x:Key="AppCanvasPlaceholderGlyphBrush" Color="#FF7A2E2E" />
      <SolidColorBrush x:Key="AppCanvasCaretBrush" Color="#FF4C9EEB" />
      <SolidColorBrush x:Key="AppWarningTextBrush" Color="#FFFFB454" />
      <SolidColorBrush x:Key="AppWidgetBrush" Color="#D92B2B2B" />
      <SolidColorBrush x:Key="AppDropZoneBrush" Color="#504C9EEB" />
      <SolidColorBrush x:Key="AppLandingOutlineBrush" Color="#FF4C9EEB" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Spacing -->
  <x:Double x:Key="AppSpacingSmall">4</x:Double>
  <x:Double x:Key="AppSpacingMedium">8</x:Double>
  <x:Double x:Key="AppSpacingLarge">16</x:Double>
  <Thickness x:Key="AppDialogPadding">24</Thickness>

  <!-- Typography -->
  <x:Double x:Key="AppFontSizeTitle">20</x:Double>

  <!-- Canvas. The fallback and placeholder colours flag cells whose glyph the document's font
       doesn't have (ADR 0013); they're temporary until the owner designs that marker. -->
  <x:Double x:Key="AppCanvasMargin">32</x:Double>
  <!-- The text caret is an outline around its cell, this many logical pixels thick. -->
  <x:Double x:Key="AppCanvasCaretThickness">2</x:Double>

  <!-- Status bar -->
  <Thickness x:Key="AppStatusBarPadding">8,2</Thickness>
  <x:Double x:Key="AppStatusBarSpacing">24</x:Double>

  <!-- Toolbar -->
  <Thickness x:Key="AppToolbarPadding">8,4</Thickness>
  <!-- The extra gap between groups of toolbar buttons. -->
  <x:Double x:Key="AppToolbarGroupGap">12</x:Double>
  <!-- How far one notch of the wheel moves a toolbar that doesn't fit. -->
  <x:Double x:Key="AppToolbarWheelStep">50</x:Double>
  <!-- Between toolbars sharing an edge. -->
  <x:Double x:Key="AppToolbarGap">8</x:Double>
  <!-- A toolbar that can't get this long is left out until there's room. -->
  <x:Double x:Key="AppToolbarMinLength">80</x:Double>
  <!-- How much more of a shared edge a middle toolbar gets than a corner one. -->
  <x:Double x:Key="AppToolbarMiddlePriority">1.25</x:Double>
  <!-- The 6-dot grip at each end: how much length it takes, and how faint it is while the pointer's over the toolbar. -->
  <x:Double x:Key="AppToolbarGripLength">14</x:Double>
  <x:Double x:Key="AppToolbarGripDotSize">2</x:Double>
  <x:Double x:Key="AppToolbarGripDotGap">2</x:Double>
  <x:Double x:Key="AppToolbarGripHoverOpacity">0.6</x:Double>
  <!-- How long the fade is on a side of a toolbar with more to scroll to. -->
  <x:Double x:Key="AppToolbarFadeLength">20</x:Double>
  <!-- How much of its edge a strip always gets while dragging a toolbar, from 0 to 1. Corner squares give way for it. -->
  <x:Double x:Key="AppToolbarZoneMinimumShare">0.3</x:Double>
  <!-- How much of a drop zone still shows while the copy of a toolbar being pushed back overlaps it. -->
  <x:Double x:Key="AppDropZoneDimmedOpacity">0.4</x:Double>
  <!-- How see-through a dragged toolbar gets while it's over a drop zone. -->
  <x:Double x:Key="AppToolbarAnchoringOpacity">0.35</x:Double>
  <!-- The most times its parent's length that a sub-toolbar gets, when its parent isn't short of room. -->
  <x:Double x:Key="AppSubToolbarLengthFactor">1.5</x:Double>
  <!-- The preview of where a dragged toolbar would land. Its outline's dashes are in multiples of its thickness. -->
  <x:Double x:Key="AppLandingToolbarOpacity">0.6</x:Double>
  <x:Double x:Key="AppLandingOutlineThickness">1.5</x:Double>
  <x:Double x:Key="AppLandingOutlineDash">4</x:Double>
  <x:Double x:Key="AppLandingOutlineDashGap">3</x:Double>
  <!-- How fast the outline's dashes run around it, in logical pixels a second. -->
  <x:Double x:Key="AppLandingAntsSpeed">24</x:Double>

  <!-- Windows and toolbars (docs/DOCKING.md). -->
  <!-- Around widgets, and around toolbars in the canvas region, so their edges line up. -->
  <x:Double x:Key="AppDockingMargin">8</x:Double>
  <!-- How far the pointer has to move before a press on a grip counts as a drag. -->
  <x:Double x:Key="AppDockingDragThreshold">4</x:Double>
  <!-- How long a toolbar takes to slide to a new place. Drop zones and hidden toolbars take this long to fade after a drag. -->
  <x:Double x:Key="AppDockingMotionMilliseconds">120</x:Double>
  <x:Double x:Key="AppWidgetGap">8</x:Double>
  <x:Double x:Key="AppWidgetWidth">240</x:Double>
  <x:Double x:Key="AppWindowTitleHeight">28</x:Double>
  <Thickness x:Key="AppWindowTitlePadding">8,0</Thickness>
  <!-- A window squeezed below this shows only its title. -->
  <x:Double x:Key="AppWindowMinHeight">140</x:Double>
  <!-- Sides shrink before the space between them gets narrower than this. -->
  <x:Double x:Key="AppCanvasRegionMinWidth">320</x:Double>

  <!-- History panel -->
  <Thickness x:Key="AppHistoryRowPadding">8,4</Thickness>

  <!-- Layers panel -->
  <Thickness x:Key="AppLayerRowPadding">4,0</Thickness>
  <x:Double x:Key="AppLayerCheckBoxWidth">28</x:Double>

  <!-- The main window's smallest size, unless the screen has less room (WindowMinimumSize). -->
  <x:Double x:Key="AppMainWindowMinWidth">1280</x:Double>
  <x:Double x:Key="AppMainWindowMinHeight">720</x:Double>

  <!-- Dialogs -->
  <Thickness x:Key="AppDialogButtonsMargin">0,16,0,0</Thickness>
  <x:Double x:Key="AppDialogMinWidth">320</x:Double>
  <x:Double x:Key="AppDialogMaxWidth">480</x:Double>
  <x:Double x:Key="AppNumberBoxWidth">140</x:Double>
  <x:Double x:Key="AppResizeAnchorButtonSize">32</x:Double>
  <x:Double x:Key="AppFontListHeight">320</x:Double>
</ResourceDictionary>
