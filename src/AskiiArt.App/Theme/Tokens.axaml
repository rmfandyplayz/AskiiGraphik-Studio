<!-- Written with Claude Code (Anthropic). -->
<!-- Design tokens (ARCHITECTURE §14.5). Placeholder UI uses only these, never literal colors or
     sizes, so the owner's design system can replace them in one place. Colors have a light and a
     dark value; everything else is shared. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FF5F5F5F" />
      <SolidColorBrush x:Key="AppCanvasPasteboardBrush" Color="#FFC8C8C8" />
      <SolidColorBrush x:Key="AppCanvasPaperBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AppCanvasInkBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="AppCanvasGridLineBrush" Color="#1F000000" />
      <SolidColorBrush x:Key="AppCanvasHoverBrush" Color="#400078D7" />
      <SolidColorBrush x:Key="AppCanvasFallbackGlyphBrush" Color="#FFFFD699" />
      <SolidColorBrush x:Key="AppCanvasPlaceholderGlyphBrush" Color="#FFFF9E9E" />
      <SolidColorBrush x:Key="AppCanvasCaretBrush" Color="#FF0078D7" />
      <SolidColorBrush x:Key="AppCanvasSelectionBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="AppCanvasSelectionBackdropBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionHatchBrush" Color="#55000000" />
      <SolidColorBrush x:Key="AppCanvasSelectionHatchBackdropBrush" Color="#09FFFFFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractBrush" Color="#FFCC4444" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractBackdropBrush" Color="#FF5C0000" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectBrush" Color="#FF9999F2" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectBackdropBrush" Color="#FF002B66" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractHatchBrush" Color="#DDFF3B30" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractHatchBackdropBrush" Color="#DD5C0000" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectHatchBrush" Color="#DD2F8CFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectHatchBackdropBrush" Color="#DD002B66" />
      <SolidColorBrush x:Key="AppWarningTextBrush" Color="#FF9A5B00" />
      <SolidColorBrush x:Key="AppWidgetBrush" Color="#D9F3F3F3" />
      <SolidColorBrush x:Key="AppDropZoneBrush" Color="#400078D7" />
      <SolidColorBrush x:Key="AppLandingOutlineBrush" Color="#FF0078D7" />
      <SolidColorBrush x:Key="AppWindowButtonHoverBrush" Color="#26000000" />
      <SolidColorBrush x:Key="AppWindowIconBrush" Color="#FF202020" />
      <SolidColorBrush x:Key="AppWindowPlaceholderBrush" Color="#260078D7" />
      <SolidColorBrush x:Key="AppWindowPlaceholderLineBrush" Color="#800078D7" />
      <SolidColorBrush x:Key="AppWindowLandingHatchBrush" Color="#330078D7" />
      <SolidColorBrush x:Key="AppResizeLineHoverBrush" Color="#590078D7" />
      <SolidColorBrush x:Key="AppResizeLineHeldBrush" Color="#FF0078D7" />
      <SolidColorBrush x:Key="AppDockBrush" Color="#FFF3F3F3" />
      <SolidColorBrush x:Key="AppDockBorderBrush" Color="#FFC8C8C8" />
      <SolidColorBrush x:Key="AppDockSelectedTabBrush" Color="#FFDCDCDC" />
      <SolidColorBrush x:Key="AppColorSwatchBorderBrush" Color="#FF808080" />
      <SolidColorBrush x:Key="AppColorNoneSlashBrush" Color="#FFD32F2F" />
      <SolidColorBrush x:Key="AppChosenCharacterBrush" Color="#400078D7" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#FFB4B4B4" />
      <SolidColorBrush x:Key="AppCanvasPasteboardBrush" Color="#FF141414" />
      <SolidColorBrush x:Key="AppCanvasPaperBrush" Color="#FF262626" />
      <SolidColorBrush x:Key="AppCanvasInkBrush" Color="#FFE8E8E8" />
      <SolidColorBrush x:Key="AppCanvasGridLineBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="AppCanvasHoverBrush" Color="#504C9EEB" />
      <SolidColorBrush x:Key="AppCanvasFallbackGlyphBrush" Color="#FF6B5420" />
      <SolidColorBrush x:Key="AppCanvasPlaceholderGlyphBrush" Color="#FF7A2E2E" />
      <SolidColorBrush x:Key="AppCanvasCaretBrush" Color="#FF4C9EEB" />
      <SolidColorBrush x:Key="AppCanvasSelectionBrush" Color="#FF000000" />
      <SolidColorBrush x:Key="AppCanvasSelectionBackdropBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionHatchBrush" Color="#0F000000" />
      <SolidColorBrush x:Key="AppCanvasSelectionHatchBackdropBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractBrush" Color="#FFFF9C96" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractBackdropBrush" Color="#FF5C0000" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectBrush" Color="#FF9DC0F2" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectBackdropBrush" Color="#FF002B66" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractHatchBrush" Color="#FFFF3B30" />
      <SolidColorBrush x:Key="AppCanvasSelectionSubtractHatchBackdropBrush" Color="#FF5C0000" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectHatchBrush" Color="#FF2F8CFF" />
      <SolidColorBrush x:Key="AppCanvasSelectionIntersectHatchBackdropBrush" Color="#FF002B66" />
      <SolidColorBrush x:Key="AppWarningTextBrush" Color="#FFFFB454" />
      <SolidColorBrush x:Key="AppWidgetBrush" Color="#D92B2B2B" />
      <SolidColorBrush x:Key="AppDropZoneBrush" Color="#504C9EEB" />
      <SolidColorBrush x:Key="AppLandingOutlineBrush" Color="#FF4C9EEB" />
      <SolidColorBrush x:Key="AppWindowButtonHoverBrush" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="AppWindowIconBrush" Color="#FFE8E8E8" />
      <SolidColorBrush x:Key="AppWindowPlaceholderBrush" Color="#264C9EEB" />
      <SolidColorBrush x:Key="AppWindowPlaceholderLineBrush" Color="#804C9EEB" />
      <SolidColorBrush x:Key="AppWindowLandingHatchBrush" Color="#334C9EEB" />
      <SolidColorBrush x:Key="AppResizeLineHoverBrush" Color="#594C9EEB" />
      <SolidColorBrush x:Key="AppResizeLineHeldBrush" Color="#FF4C9EEB" />
      <SolidColorBrush x:Key="AppDockBrush" Color="#FF2B2B2B" />
      <SolidColorBrush x:Key="AppDockBorderBrush" Color="#FF3C3C3C" />
      <SolidColorBrush x:Key="AppDockSelectedTabBrush" Color="#FF3C3C3C" />
      <SolidColorBrush x:Key="AppColorSwatchBorderBrush" Color="#FF8C8C8C" />
      <SolidColorBrush x:Key="AppColorNoneSlashBrush" Color="#FFFF6B6B" />
      <SolidColorBrush x:Key="AppChosenCharacterBrush" Color="#504C9EEB" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Spacing -->
  <x:Double x:Key="AppSpacingSmall">4</x:Double>
  <x:Double x:Key="AppSpacingMedium">8</x:Double>
  <x:Double x:Key="AppSpacingLarge">16</x:Double>
  <Thickness x:Key="AppDialogPadding">24</Thickness>

  <!-- Typography -->
  <x:Double x:Key="AppFontSizeTitle">20</x:Double>

  <!-- Canvas. The fallback and placeholder colours flag cells whose glyph the document's font
       doesn't have (ADR 0013); they're temporary until the owner designs that marker. -->
  <!-- The empty space past the zone around the canvas, or past the room around a selection beyond it, when the view
       is scrolled to an edge, in logical pixels (ADR 0072). After something moves, the view glides back out of space
       nothing needs any more over this many milliseconds. A paste out of view brings the view to it, zoom and all,
       over the zoom glide's milliseconds (ADR 0076, placeholder). -->
  <x:Double x:Key="AppCanvasMargin">64</x:Double>
  <x:Double x:Key="AppCanvasViewGlideMilliseconds">150</x:Double>
  <x:Double x:Key="AppCanvasZoomGlideMilliseconds">250</x:Double>
  <!-- The text caret is an outline around its cell, this many logical pixels thick. -->
  <x:Double x:Key="AppCanvasCaretThickness">2</x:Double>
  <!-- The selection outline (step 4.1, placeholder): black dashes on white, this many logical pixels thick, each
       dash and gap this long, so it shows on any art. The dashes run clockwise around the selection at this many
       logical pixels a second, a whole device pixel at a time. -->
  <x:Double x:Key="AppCanvasSelectionThickness">1</x:Double>
  <x:Double x:Key="AppCanvasSelectionDashLength">4</x:Double>
  <x:Double x:Key="AppCanvasSelectionAntsSpeed">12</x:Double>
  <!-- The selection overlay (step 4.2b, placeholder, ADR 0061). Cells that aren't selected are hatched with stripes
       rising to the right, dark and light side by side like a zebra's, each this many logical pixels wide (ADR 0064),
       moving to the top left at this many times the outline's dash speed, in this many steps for each screen pixel,
       so they glide (ADR 0062). While a selection tool is used, the cells it would deselect are hatched the other way
       in Subtract's reds or Intersect's blues, this strongly, moving to the bottom left at these speeds, while the
       other hatching stands still. Subtract's and Intersect's dashes are lighter than their hatching. The grid shows
       this strongly under the hatching. The shape's lines that won't be kept show this faintly, and the old
       selection's this faintly. A lasso shows how it would close this faintly. The Polygonal Lasso's corners have
       dots this big and this strong, and its first corner a marker this big, which finishes the shape when clicked. -->
  <x:Double x:Key="AppCanvasSelectionHatchBandWidth">8</x:Double>
  <x:Double x:Key="AppCanvasSelectionHatchSpeed">1</x:Double>
  <x:Double x:Key="AppCanvasSelectionHatchStepsPerPixel">2</x:Double>
  <x:Double x:Key="AppCanvasSelectionLostHatchOpacity">0.4</x:Double>
  <x:Double x:Key="AppCanvasSelectionSubtractHatchSpeed">1</x:Double>
  <x:Double x:Key="AppCanvasSelectionIntersectHatchSpeed">1</x:Double>
  <x:Double x:Key="AppCanvasGridUnderHatchOpacity">0.4</x:Double>
  <x:Double x:Key="AppCanvasGridUnderLostHatchOpacity">0.7</x:Double>
  <x:Double x:Key="AppCanvasSelectionFaintOpacity">0.35</x:Double>
  <x:Double x:Key="AppCanvasSelectionVanishingOpacity">0.15</x:Double>
  <x:Double x:Key="AppCanvasSelectionOffCanvasOpacity">0.5</x:Double>
  <x:Double x:Key="AppCanvasSelectionDroppedOffCanvasOpacity">0.15</x:Double>
  <x:Double x:Key="AppCanvasSelectionClosingLineOpacity">0.35</x:Double>
  <x:Double x:Key="AppCanvasCornerMarkerRadius">3.5</x:Double>
  <x:Double x:Key="AppCanvasFinishMarkerRadius">8</x:Double>
  <x:Double x:Key="AppCanvasCornerMarkerOpacity">0.85</x:Double>
  <!-- A curve's handles (step 5.5, placeholder, ADR 0083): a line from the anchor to a square this many logical pixels
       from its middle to its sides, this strong for the selected anchor and the one under the pointer, and this strong
       for the others. -->
  <x:Double x:Key="AppCanvasHandleEndRadius">3</x:Double>
  <x:Double x:Key="AppCanvasStrongHandleOpacity">0.9</x:Double>
  <x:Double x:Key="AppCanvasFaintHandleOpacity">0.2</x:Double>

  <!-- Status bar -->
  <Thickness x:Key="AppStatusBarPadding">8,2</Thickness>
  <x:Double x:Key="AppStatusBarSpacing">24</x:Double>
  <Thickness x:Key="AppStatusBarFrameRateMargin">24,0,0,0</Thickness>

  <!-- Toolbar -->
  <Thickness x:Key="AppToolbarPadding">8,4</Thickness>
  <!-- The extra gap between groups of toolbar buttons. -->
  <x:Double x:Key="AppToolbarGroupGap">12</x:Double>
  <!-- How far one notch of the wheel moves a toolbar that doesn't fit. -->
  <x:Double x:Key="AppToolbarWheelStep">50</x:Double>
  <!-- Between toolbars sharing an edge. -->
  <x:Double x:Key="AppToolbarGap">8</x:Double>
  <!-- A toolbar that can't get this long is left out until there's room. -->
  <x:Double x:Key="AppToolbarMinLength">80</x:Double>
  <!-- How much more of a shared edge a middle toolbar gets than a corner one. -->
  <x:Double x:Key="AppToolbarMiddlePriority">1.25</x:Double>
  <!-- The 6-dot grip at each end: how much length it takes, and how faint it is while the pointer's over the toolbar. -->
  <x:Double x:Key="AppToolbarGripLength">14</x:Double>
  <x:Double x:Key="AppToolbarGripDotSize">2</x:Double>
  <x:Double x:Key="AppToolbarGripDotGap">2</x:Double>
  <x:Double x:Key="AppToolbarGripHoverOpacity">0.6</x:Double>
  <!-- How long the fade is on a side of a toolbar with more to scroll to. -->
  <x:Double x:Key="AppToolbarFadeLength">20</x:Double>
  <!-- How much of its edge a strip always gets while dragging a toolbar, from 0 to 1. Corner squares give way for it. -->
  <x:Double x:Key="AppToolbarZoneMinimumShare">0.3</x:Double>
  <!-- How much of a drop zone still shows while the copy of a toolbar being pushed back overlaps it. -->
  <x:Double x:Key="AppDropZoneDimmedOpacity">0.4</x:Double>
  <!-- How see-through a dragged toolbar gets while it's over a drop zone. -->
  <x:Double x:Key="AppToolbarAnchoringOpacity">0.35</x:Double>
  <!-- The most times its parent's length that a sub-toolbar gets, when its parent isn't short of room. -->
  <x:Double x:Key="AppSubToolbarLengthFactor">1.5</x:Double>
  <!-- The preview of where a dragged toolbar would land. Its outline's dashes are in multiples of its thickness. -->
  <x:Double x:Key="AppLandingToolbarOpacity">0.6</x:Double>
  <x:Double x:Key="AppLandingOutlineThickness">1.5</x:Double>
  <x:Double x:Key="AppLandingOutlineDash">4</x:Double>
  <x:Double x:Key="AppLandingOutlineDashGap">3</x:Double>
  <!-- How fast the outline's dashes run around it, in logical pixels a second. -->
  <x:Double x:Key="AppLandingAntsSpeed">24</x:Double>

  <!-- Windows and toolbars (docs/DOCKING.md). -->
  <!-- Around widgets, and around toolbars in the canvas region, so their edges line up. -->
  <x:Double x:Key="AppDockingMargin">8</x:Double>
  <!-- How far the pointer has to move before a press on a grip counts as a drag. -->
  <x:Double x:Key="AppDockingDragThreshold">4</x:Double>
  <!-- How long a toolbar takes to slide to a new place. Drop zones and hidden toolbars take this long to fade after a drag. -->
  <x:Double x:Key="AppDockingMotionMilliseconds">120</x:Double>
  <x:Double x:Key="AppWidgetGap">8</x:Double>
  <x:Double x:Key="AppWidgetWidth">240</x:Double>
  <x:Double x:Key="AppWindowTitleHeight">28</x:Double>
  <Thickness x:Key="AppWindowTitlePadding">8,0</Thickness>
  <!-- A window squeezed below this shows only its title. -->
  <x:Double x:Key="AppWindowMinHeight">140</x:Double>
  <!-- The narrowest a side's windows or a floating window can be made. -->
  <x:Double x:Key="AppWindowMinWidth">160</x:Double>
  <!-- How tall a title-only widget is when it lands floating. -->
  <x:Double x:Key="AppFloatingWindowHeight">280</x:Double>
  <!-- How far inwards and down a window moves when its menu floats it, so that it visibly comes off the side. -->
  <x:Double x:Key="AppWindowFloatOffset">24</x:Double>
  <!-- The thickness of the zone along a floating window's edges that resizes it, and the size of its corners' zones. -->
  <x:Double x:Key="AppWindowResizeGripSize">5</x:Double>
  <x:Double x:Key="AppWindowResizeCornerSize">10</x:Double>
  <!-- The menu and close buttons in a window's title row. -->
  <x:Double x:Key="AppWindowButtonSize">20</x:Double>
  <x:Double x:Key="AppWindowButtonFaintOpacity">0.5</x:Double>
  <x:Double x:Key="AppWindowIconThickness">1.2</x:Double>
  <StreamGeometry x:Key="AppWindowMenuIcon">M0,1.5 H10 M0,5 H10 M0,8.5 H10</StreamGeometry>
  <StreamGeometry x:Key="AppWindowCloseIcon">M1,1 L9,9 M9,1 L1,9</StreamGeometry>
  <!-- The zone at a side's edge while dragging a window. How thick the strip showing where the window would go is on a
       border in a dock, and how far it keeps from everything around it there, on every side. -->
  <x:Double x:Key="AppWindowEdgeStripWidth">24</x:Double>
  <x:Double x:Key="AppThinDropMarkerThickness">20</x:Double>
  <x:Double x:Key="AppDropMarkerPadding">4</x:Double>
  <!-- How thick the handles on the borders between dock windows are. During a window drag, how deep the bands along
       the top and bottom of a dock column are, and how thick the zones along the borders between dock windows. -->
  <x:Double x:Key="AppDockHandleThickness">6</x:Double>
  <x:Double x:Key="AppDockBandLength">48</x:Double>
  <x:Double x:Key="AppDockBorderZoneThickness">24</x:Double>
  <!-- A dock window's outline, and the padding around each tab's title. -->
  <Thickness x:Key="AppDockBorderThickness">1</Thickness>
  <Thickness x:Key="AppDockTabPadding">8,0</Thickness>
  <!-- The hatched strip and tab showing where a dragged window would go. -->
  <x:Double x:Key="AppWindowPlaceholderHatchGap">10</x:Double>
  <x:Double x:Key="AppWindowPlaceholderLineThickness">1</x:Double>
  <x:Double x:Key="AppWindowPlaceholderPlusSize">10</x:Double>
  <!-- The line along a gap between widgets, or a side's inner edge: faint with the pointer over it, solid while held. -->
  <x:Double x:Key="AppResizeLineThickness">3</x:Double>
  <!-- Sides shrink before the space between them gets narrower than this. -->
  <x:Double x:Key="AppCanvasRegionMinWidth">320</x:Double>

  <!-- History panel -->
  <Thickness x:Key="AppHistoryRowPadding">8,4</Thickness>

  <!-- Colors toolbar, Color and Swatches windows -->
  <Thickness x:Key="AppColorPanelPadding">8</Thickness>
  <x:Double x:Key="AppColorSwatchSize">20</x:Double>
  <Thickness x:Key="AppColorSwatchMargin">0,0,4,4</Thickness>
  <Thickness x:Key="AppColorSwatchBorderThickness">1</Thickness>
  <x:Double x:Key="AppColorNoneSlashThickness">1.5</x:Double>
  <StreamGeometry x:Key="AppColorNoneSlashGeometry">M0,0 L1,1</StreamGeometry>
  <Thickness x:Key="AppColorsToolbarSwatchPadding">4,3</Thickness>
  <x:Double x:Key="AppColorsToolbarDotSize">4</x:Double>

  <!-- Tool Options toolbar -->
  <x:Double x:Key="AppToolOptionsSpacing">16</x:Double>
  <x:Double x:Key="AppToolOptionsSliderWidth">120</x:Double>
  <x:Double x:Key="AppToolOptionsValueWidth">36</x:Double>

  <!-- Layers panel -->
  <Thickness x:Key="AppLayerRowPadding">4,0</Thickness>
  <x:Double x:Key="AppLayerCheckBoxWidth">28</x:Double>

  <!-- Ramps window. Its characters are shown in a common monospaced font, not the document's. -->
  <Thickness x:Key="AppRampsPanelPadding">8</Thickness>
  <x:Double x:Key="AppRampsListMaxHeight">200</x:Double>
  <FontFamily x:Key="AppRampTextFontFamily">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono</FontFamily>

  <!-- Characters window (ADR 0053). Its characters, and the Character Brush's on the Tool Options toolbar, are shown in
       the Ramps window's font, not the document's. -->
  <Thickness x:Key="AppCharactersPanelPadding">8</Thickness>
  <x:Double x:Key="AppCharacterButtonSize">32</x:Double>
  <x:Double x:Key="AppCharacterButtonFontSize">18</x:Double>
  <Thickness x:Key="AppCharacterButtonMargin">1</Thickness>

  <!-- The main window's smallest size, unless the screen has less room (WindowMinimumSize). -->
  <x:Double x:Key="AppMainWindowMinWidth">1280</x:Double>
  <x:Double x:Key="AppMainWindowMinHeight">720</x:Double>

  <!-- Dialogs -->
  <Thickness x:Key="AppDialogButtonsMargin">0,16,0,0</Thickness>
  <x:Double x:Key="AppDialogMinWidth">320</x:Double>
  <x:Double x:Key="AppDialogMaxWidth">480</x:Double>
  <x:Double x:Key="AppNumberBoxWidth">140</x:Double>
  <x:Double x:Key="AppResizeAnchorButtonSize">32</x:Double>
  <x:Double x:Key="AppFontListHeight">320</x:Double>
</ResourceDictionary>
