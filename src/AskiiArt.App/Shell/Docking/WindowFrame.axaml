<!-- Written with Claude Code (Anthropic). -->
<!-- What every window looks like, around whatever view it holds: a title row at the top, and the contents
     unless it's title-only. The title row's buttons only show when the pointer is over the window. A floating
     window also has grips along its edges and corners. A dock window is opaque and outlined, with a tab strip in
     place of its title and no buttons. Placeholder: the owner designs the real one. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:docking="using:AskiiArt.App.Shell.Docking"
             xmlns:res="using:AskiiArt.App.Resources"
             x:Class="AskiiArt.App.Shell.Docking.WindowFrame">
  <UserControl.Styles>
    <Style Selector="docking|WindowFrame.anchoring">
      <Setter Property="Opacity" Value="{DynamicResource AppToolbarAnchoringOpacity}" />
    </Style>
    <Style Selector="Button.windowButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="{DynamicResource AppWindowButtonSize}" />
      <Setter Property="Height" Value="{DynamicResource AppWindowButtonSize}" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="docking|WindowFrame:pointerover Button.windowButton">
      <Setter Property="Opacity" Value="{DynamicResource AppWindowButtonFaintOpacity}" />
    </Style>
    <Style Selector="docking|WindowFrame Button.windowButton:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="docking|WindowFrame Button.windowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppWindowButtonHoverBrush}" />
    </Style>
    <Style Selector="Path.windowIcon">
      <Setter Property="Stroke" Value="{DynamicResource AppWindowIconBrush}" />
      <Setter Property="StrokeThickness" Value="{DynamicResource AppWindowIconThickness}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.edgeGrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="{DynamicResource AppWindowResizeGripSize}" />
    </Style>
    <Style Selector="Border.edgeGrip.acrossTheWindow">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="Height" Value="{DynamicResource AppWindowResizeGripSize}" />
    </Style>
    <Style Selector="Border.cornerGrip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="{DynamicResource AppWindowResizeCornerSize}" />
      <Setter Property="Height" Value="{DynamicResource AppWindowResizeCornerSize}" />
    </Style>
    <!-- In styles rather than on the strip itself, because a value set there would win over the docked style. -->
    <Style Selector="docking|WindowFrame docking|DockTabStrip#TabStrip">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="docking|WindowFrame.docked Border#Surface">
      <Setter Property="Background" Value="{DynamicResource AppDockBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDockBorderBrush}" />
      <Setter Property="BorderThickness" Value="{DynamicResource AppDockBorderThickness}" />
    </Style>
    <Style Selector="docking|WindowFrame.docked Border#TitleRow">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="docking|WindowFrame.docked Button.windowButton, docking|WindowFrame.docked TextBlock#TitleText">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="docking|WindowFrame.docked docking|DockTabStrip#TabStrip">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Last, so that it wins over the pointer being over the window or a button. -->
    <Style Selector="docking|WindowFrame.buttonsHidden Button.windowButton">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <Border x:Name="Surface" Background="{DynamicResource AppWidgetBrush}" ClipToBounds="True">
      <DockPanel>
        <Border x:Name="TitleRow"
                DockPanel.Dock="Top"
                Height="{DynamicResource AppWindowTitleHeight}"
                Padding="{DynamicResource AppWindowTitlePadding}"
                Background="Transparent">
          <DockPanel>
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    Classes="windowButton"
                    ToolTip.Tip="{x:Static res:Strings.WindowCloseButtonTip}">
              <Path Classes="windowIcon" Data="{DynamicResource AppWindowCloseIcon}" />
            </Button>
            <Button x:Name="MenuButton"
                    DockPanel.Dock="Right"
                    Classes="windowButton"
                    ToolTip.Tip="{x:Static res:Strings.WindowMenuButtonTip}">
              <Path Classes="windowIcon" Data="{DynamicResource AppWindowMenuIcon}" />
            </Button>
            <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <docking:DockTabStrip x:Name="TabStrip" />
          </DockPanel>
        </Border>
        <ContentControl x:Name="BodyHost" />
      </DockPanel>
    </Border>
    <Panel x:Name="GripLayer" IsVisible="False">
      <Border x:Name="LeftGrip" Classes="edgeGrip" Cursor="SizeWestEast" HorizontalAlignment="Left" />
      <Border x:Name="RightGrip" Classes="edgeGrip" Cursor="SizeWestEast" HorizontalAlignment="Right" />
      <Border x:Name="TopGrip" Classes="edgeGrip acrossTheWindow" Cursor="SizeNorthSouth" VerticalAlignment="Top" />
      <Border x:Name="BottomGrip" Classes="edgeGrip acrossTheWindow" Cursor="SizeNorthSouth" VerticalAlignment="Bottom" />
      <Border x:Name="TopLeftGrip" Classes="cornerGrip" Cursor="TopLeftCorner" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <Border x:Name="TopRightGrip" Classes="cornerGrip" Cursor="TopRightCorner" HorizontalAlignment="Right" VerticalAlignment="Top" />
      <Border x:Name="BottomLeftGrip" Classes="cornerGrip" Cursor="BottomLeftCorner" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
      <Border x:Name="BottomRightGrip" Classes="cornerGrip" Cursor="BottomRightCorner" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Panel>
  </Panel>
</UserControl>
