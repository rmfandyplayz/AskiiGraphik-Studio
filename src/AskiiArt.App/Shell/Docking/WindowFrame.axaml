<!-- Written with Claude Code (Anthropic). -->
<!-- What every window looks like, around whatever view it holds: a title at the top, and the contents
     unless it's title-only. Placeholder: the owner designs the real one. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AskiiArt.App.Shell.Docking.WindowFrame">
  <Border Background="{DynamicResource AppWidgetBrush}" ClipToBounds="True">
    <DockPanel>
      <Border DockPanel.Dock="Top"
              Height="{DynamicResource AppWindowTitleHeight}"
              Padding="{DynamicResource AppWindowTitlePadding}">
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Border>
      <ContentControl x:Name="BodyHost" />
    </DockPanel>
  </Border>
</UserControl>
