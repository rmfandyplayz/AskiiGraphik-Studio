<!-- Written with Claude Code (Anthropic). -->
<!-- Makes Dock's layout a see-through layer over the canvas (ADR 0025). Dock's templates give empty
     areas an invisible background, which catches clicks. Each selector below depends on a property,
     which gives its setters a higher priority than a template's values. While a panel is being dragged
     the backgrounds come back, because Dock finds its drop areas by hit testing them.
     tests/AskiiArt.App.Tests/Shell/Docking/ClickRoutingTests.cs fails if a Dock update breaks this. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:panels="using:Dock.Controls.ProportionalStackPanel"
        xmlns:docking="using:AskiiArt.App.Shell.Docking"
        xmlns:dockcore="using:Dock.Model.Core">
  <Style Selector="dock|DockControl[IsDraggingDock=False] dock|ToolDockControl">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl[IsDraggingDock=False] dock|DockableControl">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl[IsDraggingDock=False] panels|ProportionalStackPanel">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="dock|DockControl[IsDraggingDock=False] dock|RootDockControl /template/ DockPanel">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>

  <!-- A floating panel's title has a small handle that starts a different kind of drag, one that would
       dock Dock's internal wrapper instead of the panel. Without hits it's plain header, which moves
       the panel like the rest of the header does. -->
  <Style Selector="dock|MdiDocumentWindow /template/ Border#PART_DragHandle">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- The widget look. Placeholder: the owner designs the real one. -->
  <Style Selector="dock|ToolChromeControl" x:DataType="dockcore:IDock">
    <Setter Property="Background" Value="{DynamicResource AppWidgetBrush}" />
    <Setter Property="Margin" Value="{DynamicResource AppWidgetMargin}" />
    <Setter Property="HorizontalAlignment"
            Value="{Binding ActiveDockable.Id, Converter={x:Static docking:PanelAlignment.ForPanelId}, FallbackValue=Stretch}" />
  </Style>
</Styles>
