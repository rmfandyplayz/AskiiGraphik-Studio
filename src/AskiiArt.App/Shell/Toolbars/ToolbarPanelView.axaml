<!-- Written with Claude Code (Anthropic). -->
<!-- A toolbar: its look and its buttons. A bar that doesn't fit scrolls sideways with no scrollbar. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AskiiArt.App.Shell.Toolbars.ToolbarPanelView">
  <Border Background="{DynamicResource AppWidgetBrush}" ClipToBounds="True">
    <ScrollViewer x:Name="Scroller"
                  HorizontalScrollBarVisibility="Hidden"
                  VerticalScrollBarVisibility="Disabled" />
  </Border>
</UserControl>
