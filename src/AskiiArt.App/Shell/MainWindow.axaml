<!-- Written with Claude Code (Anthropic). -->
<!-- The main window. The menu bar and the status bar are plain strips along the top and bottom. Between
     them the canvas fills the space, with windows and toolbars on top of it. Their host has no background,
     so clicks reach the canvas wherever there's nothing (ADR 0035). MainWindowBuilder fills them in. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:AskiiArt.App.Resources"
        xmlns:canvas="using:AskiiArt.App.Canvas"
        xmlns:shell="using:AskiiArt.App.Shell"
        xmlns:docking="using:AskiiArt.App.Shell.Docking"
        x:Class="AskiiArt.App.Shell.MainWindow"
        x:DataType="canvas:CanvasViewModel"
        Title="{x:Static res:Strings.AppDisplayName}">
  <DockPanel>
    <Border x:Name="MenuBarStrip" DockPanel.Dock="Top" />
    <shell:StatusBarView DockPanel.Dock="Bottom" />
    <Panel>
      <canvas:CanvasView x:Name="CanvasView" />
      <docking:DockingHost x:Name="DockingLayer" />
    </Panel>
  </DockPanel>
</Window>
