<!-- Written with Claude Code (Anthropic). -->
<!-- Placeholder main window: a menu bar and nothing else yet. The menus themselves are built in
     code from the MenuLayout (see MainWindowBuilder). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:AskiiArt.App.Resources"
        x:Class="AskiiArt.App.Shell.MainWindow"
        Title="{x:Static res:Strings.AppDisplayName}">
  <DockPanel>
    <!-- Shows the window's native menu on Windows and Linux; hides itself on macOS, where the
         menu goes to the system menu bar instead. -->
    <NativeMenuBar DockPanel.Dock="Top" />
    <Panel />
  </DockPanel>
</Window>
