<!-- Written with Claude Code (Anthropic). -->
<!-- The main window. The menu bar and the status bar are plain strips along the top and bottom (ADR 0029).
     Between them the canvas fills the space, with the dock layout on top of it, which passes clicks
     through wherever it has no widget (ADR 0025). MainWindowBuilder fills them in. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="using:AskiiArt.App.Resources"
        xmlns:canvas="using:AskiiArt.App.Canvas"
        xmlns:shell="using:AskiiArt.App.Shell"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="AskiiArt.App.Shell.MainWindow"
        x:DataType="canvas:CanvasViewModel"
        Title="{x:Static res:Strings.AppDisplayName}">
  <DockPanel>
    <Border x:Name="MenuBarStrip" DockPanel.Dock="Top" />
    <shell:StatusBarView DockPanel.Dock="Bottom" />
    <Panel>
      <canvas:CanvasView x:Name="CanvasView" />
      <dock:DockControl x:Name="PanelDock"
                        InitializeFactory="True"
                        EnableManagedWindowLayer="True" />
    </Panel>
  </DockPanel>
</Window>
