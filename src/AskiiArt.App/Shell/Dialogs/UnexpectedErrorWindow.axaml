<!-- Written with Claude Code (Anthropic). -->
<!-- Placeholder dialog shown when an unexpected error reaches the UI thread (ADR 0008). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:AskiiArt.App.Shell.Dialogs"
        xmlns:res="using:AskiiArt.App.Resources"
        x:Class="AskiiArt.App.Shell.Dialogs.UnexpectedErrorWindow"
        x:DataType="dialogs:UnexpectedErrorViewModel"
        Title="{x:Static res:Strings.UnexpectedErrorTitle}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="{StaticResource AppDialogPadding}"
              Spacing="{StaticResource AppSpacingMedium}"
              MinWidth="{StaticResource AppDialogMinWidth}"
              MaxWidth="{StaticResource AppDialogMaxWidth}">
    <TextBlock Text="{x:Static res:Strings.UnexpectedErrorMessage}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="{StaticResource AppDialogButtonsMargin}"
                Spacing="{StaticResource AppSpacingMedium}">
      <Button Content="{x:Static res:Strings.UnexpectedErrorOpenLogFolder}"
              Command="{Binding OpenLogFolderCommand}" />
      <Button Content="{x:Static res:Strings.UnexpectedErrorQuit}"
              Click="OnQuitClick" />
      <Button Content="{x:Static res:Strings.UnexpectedErrorContinue}"
              IsDefault="True"
              IsCancel="True"
              Click="OnContinueClick" />
    </StackPanel>
  </StackPanel>
</Window>
