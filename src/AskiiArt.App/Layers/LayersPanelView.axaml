<!-- Written with Claude Code (Anthropic). -->
<!-- Placeholder Layers panel: the layers, top one first, with the active one selected and buttons
     below. Each row has checkboxes for visible and locked; double-clicking a row renames it. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:layers="using:AskiiArt.App.Layers"
             xmlns:res="using:AskiiArt.App.Resources"
             x:Class="AskiiArt.App.Layers.LayersPanelView"
             x:DataType="layers:LayersPanelViewModel">
  <DockPanel>
    <ContentControl x:Name="ButtonsHost" DockPanel.Dock="Bottom" />
    <ListBox x:Name="Rows"
             Background="{x:Null}"
             ItemsSource="{Binding Rows}"
             SelectedIndex="{Binding ActiveRow, Mode=TwoWay}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="{DynamicResource AppLayerRowPadding}" />
        </Style>
        <Style Selector="CheckBox">
          <Setter Property="MinWidth" Value="{DynamicResource AppLayerCheckBoxWidth}" />
          <Setter Property="Width" Value="{DynamicResource AppLayerCheckBoxWidth}" />
          <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="TextBlock.hidden">
          <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="layers:LayerRow">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <CheckBox IsChecked="{Binding IsShown}"
                      ToolTip.Tip="{x:Static res:Strings.LayerRowVisibleTip}" />
            <CheckBox Grid.Column="1"
                      IsChecked="{Binding IsLocked}"
                      ToolTip.Tip="{x:Static res:Strings.LayerRowLockedTip}" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Name}"
                       Classes.hidden="{Binding !IsShown}"
                       IsVisible="{Binding !IsRenaming}" />
            <TextBox Grid.Column="2"
                     Text="{Binding NameBeingEdited}"
                     IsVisible="{Binding IsRenaming}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
