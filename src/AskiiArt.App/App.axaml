<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Fluent"
             x:Class="AskiiArt.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AskiiArt.App/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <dockTheme:DockFluentTheme />
    <StyleInclude Source="avares://AskiiArt.App/Shell/Docking/DockStyles.axaml" />
  </Application.Styles>
</Application>
