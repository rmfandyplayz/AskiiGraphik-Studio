<!-- Written with Claude Code (Anthropic). -->
<!-- Placeholder Brush Options window (step 2b.3a): the FG and BG colours, one of which is the one the Color
     and Swatches windows change. Brush size and the like join it later. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:painting="using:AskiiArt.App.Painting"
             xmlns:res="using:AskiiArt.App.Resources"
             x:Class="AskiiArt.App.Painting.BrushOptionsView"
             x:DataType="painting:PaintColorsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.swatch">
      <Setter Property="Width" Value="{StaticResource AppColorSwatchSize}" />
      <Setter Property="Height" Value="{StaticResource AppColorSwatchSize}" />
      <Setter Property="BorderThickness" Value="{StaticResource AppColorSwatchBorderThickness}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppColorSwatchBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource AppSecondaryTextBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer>
    <StackPanel Margin="{StaticResource AppColorPanelPadding}" Spacing="{StaticResource AppSpacingSmall}">
      <!-- Not focusable, so the canvas keeps the keyboard and X and D still work after a click here. -->
      <RadioButton x:Name="ForegroundButton"
                   GroupName="PaintColorTarget"
                   Focusable="False"
                   IsChecked="{Binding IsForegroundTarget, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingMedium}">
          <Border Classes="swatch" Background="{Binding ForegroundBrush}" />
          <TextBlock Text="{Binding ForegroundText}" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="BackgroundButton"
                   GroupName="PaintColorTarget"
                   Focusable="False"
                   IsChecked="{Binding IsBackgroundTarget, Mode=TwoWay}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AppSpacingMedium}">
          <Border Classes="swatch" Background="{Binding BackgroundBrush}" />
          <TextBlock Text="{Binding BackgroundText}" VerticalAlignment="Center" />
        </StackPanel>
      </RadioButton>
      <TextBlock Classes="note"
                 IsVisible="{Binding IsMonochrome}"
                 Text="{x:Static res:Strings.PaintColorsNeedColorsNote}" />
      <TextBlock Classes="note" Text="{x:Static res:Strings.BrushOptionsKeysHint}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
